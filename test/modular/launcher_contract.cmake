string(RANDOM LENGTH 12 token)
set(work "${WORK}-${token}")
file(MAKE_DIRECTORY "${work}")
set(ENV{APPDATA} "${work}/roaming")
set(global "${work}/roaming/thprac/plugins")
file(COPY "${LAUNCHER}" DESTINATION "${work}")
get_filename_component(name "${LAUNCHER}" NAME)
get_filename_component(distribution "${LAUNCHER}" DIRECTORY)

function(check_plugins expected)
    execute_process(COMMAND "${work}/${name}" --list-plugins
        WORKING_DIRECTORY "${work}" OUTPUT_VARIABLE output RESULT_VARIABLE result TIMEOUT 15)
    string(REGEX REPLACE "[\r\n]+$" "" output "${output}")
    string(REPLACE "\r" "" output "${output}")
    if(NOT result STREQUAL "0" OR NOT output STREQUAL expected)
        message(FATAL_ERROR "Expected '${expected}', got '${output}' (${result})")
    endif()
endfunction()

check_plugins("")
file(MAKE_DIRECTORY "${work}/plugins/launcher" "${work}/plugins/shared")
file(COPY "${distribution}/plugins/launcher/launcher_layout.thp.dll" DESTINATION "${work}/plugins/launcher")
file(COPY "${distribution}/plugins/shared/game_volume.thp.dll" DESTINATION "${work}/plugins/shared")
check_plugins("rueee-c7.launcher-layout\nrueee-c7.volume")
file(WRITE "${work}/plugins/enabled.ini" "[launcher]\r\nfile.launcher_layout.thp.dll=0\r\n")
check_plugins("rueee-c7.volume")
file(WRITE "${work}/plugins/enabled.ini" "[launcher]\r\nfile.launcher_layout.thp.dll=1\r\n[shared]\r\nfile.game_volume.thp.dll=0\r\n")
check_plugins("rueee-c7.launcher-layout")
message(STATUS "Launcher and shared plugin preferences are independent")

# Local order wins for a duplicate ID. Disabling it exposes the global copy.
file(MAKE_DIRECTORY "${global}/launcher" "${global}/shared")
file(COPY "${distribution}/plugins/launcher/launcher_layout.thp.dll" DESTINATION "${global}/launcher")
file(COPY "${distribution}/plugins/shared/game_volume.thp.dll" DESTINATION "${global}/shared")
file(WRITE "${work}/plugins/enabled.ini" "[launcher]\r\nfile.launcher_layout.thp.dll=0\r\n")
check_plugins("rueee-c7.volume\nrueee-c7.launcher-layout")
file(APPEND "${work}/plugins/enabled.ini" "[shared]\r\nfile.game_volume.thp.dll=0\r\n")
check_plugins("rueee-c7.launcher-layout\nrueee-c7.volume")
file(WRITE "${global}/enabled.ini" "[shared]\r\nfile.game_volume.thp.dll=0\r\n")
check_plugins("rueee-c7.launcher-layout")
message(STATUS "Global scan, local ID priority, and independent global switch passed")
